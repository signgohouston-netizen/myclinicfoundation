# Public site URL (used for SEO canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://myclinicfoundation.org

# --- Backend (Phase 2 — not required for the static site to run) ---
# Database (e.g. Neon / Supabase / Postgres)
# DATABASE_URL=

# Auth (e.g. NextAuth / Clerk)
# AUTH_SECRET=

# Payments / donations (Stripe)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# Contact form email (e.g. Resend)
# RESEND_API_KEY=
